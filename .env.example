APP_NAME=RoamGenie
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_LOCAL_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Primary team database: copy current connection string from Supabase Dashboard
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional local fallback
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:LOCAL_PASSWORD@localhost:5432/ai_travel_planner
DATABASE_ENV=supabase
DB_CONNECT_TIMEOUT_SECONDS=5

# Supabase Credentials (Backend only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=NEVER_EXPOSE_THIS_TO_FRONTEND

CORS_ORIGINS=http://localhost:5173

# AI Provider Configuration (mock, gemini, openai, groq)
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=15
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Weather Provider Configuration (open-meteo, mock)
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_SECONDS=5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# Google Maps & Places Configuration (Optional)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
